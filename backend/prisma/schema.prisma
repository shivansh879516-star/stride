// STRIDE Fitness Database Schema
// Compatible with SQLite for local zero-dependency run, and PostgreSQL for production.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  username       String           @unique
  role           String           @default("ATHLETE") // ATHLETE, ADMIN
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  profile        Profile?
  activities     Activity[]
  routes         Route[]
  achievements   UserAchievement[]
  challenges     UserChallenge[]
  goals          Goal[]
  notifications  Notification[]
  devices        Device[]
  privacySettings PrivacySettings?
  privacyZones   PrivacyZone[]
  safetyContacts SafetyContact[]
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String    @default("")
  lastName       String    @default("")
  bio            String    @default("")
  avatarUrl      String    @default("")
  city           String    @default("")
  country        String    @default("")
  heightCm       Float     @default(175)
  weightKg       Float     @default(70)
  level          Int       @default(1)
  xp             Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  weeklyGoalKm   Float     @default(20.0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Activity {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?             @default("")
  activityType     String              @default("RUN") // RUN, WALK, JOG, CYCLE, HIKE
  startTime        DateTime
  endTime          DateTime
  durationSec      Int                 // Total elapsed time in seconds
  movingDurationSec Int                // Moving time without pauses
  distanceMeters   Float               // Total distance in meters
  averagePaceSec   Float               // Seconds per km
  averageSpeedKmh  Float               // km/h
  maxSpeedKmh      Float               // km/h
  calories         Int                 // Estimated active calories
  elevationGainM   Float               @default(0.0)
  elevationLossM   Float               @default(0.0)
  visibility       String              @default("PUBLIC") // PUBLIC, FOLLOWERS, PRIVATE
  isSynced         Boolean             @default(true)
  clientSyncId     String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  points           ActivityPoint[]
  statistics       ActivityStatistics?

  @@index([userId, startTime])
}

model ActivityPoint {
  id           String    @id @default(uuid())
  activityId   String
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  altitude     Float?
  accuracy     Float?
  speed        Float?    // m/s
  timestamp    DateTime
  sequenceOrder Int

  @@index([activityId, sequenceOrder])
}

model ActivityStatistics {
  id           String    @id @default(uuid())
  activityId   String    @unique
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  splitsJson   String    @default("[]") // JSON array of kilometer splits
  paceSamples  String?   @default("[]") // Sampled pace time-series
  speedSamples String?   @default("[]") // Sampled speed time-series
  elevSamples  String?   @default("[]") // Sampled elevation time-series
  cadenceAvg   Float?
  heartRateAvg Float?
}

model Route {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  activityType    String    @default("RUN")
  distanceMeters  Float
  elevationGainM  Float     @default(0.0)
  coordinatesJson String    // Array of [lat, lng]
  isPublic        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Achievement {
  id            String            @id @default(uuid())
  code          String            @unique
  title         String
  description   String
  category      String            // DISTANCE, STREAK, SPEED, MILESTONE
  icon          String            // Lucide icon identifier or name
  xpReward      Int               @default(100)
  criteriaType  String            // TOTAL_DISTANCE, SINGLE_DISTANCE, STREAK_DAYS, ACTIVITY_COUNT, FAST_PACE
  criteriaValue Float
  users         UserAchievement[]
}

model UserAchievement {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime     @default(now())

  @@unique([userId, achievementId])
}

model Challenge {
  id           String          @id @default(uuid())
  code         String          @unique
  title        String
  description  String
  category     String          // DISTANCE, TIME, CONSISTENCY
  targetValue  Float           // e.g. 50 km or 5 days
  targetUnit   String          // KM, HOURS, DAYS
  startDate    DateTime
  endDate      DateTime
  xpReward     Int             @default(500)
  badgeIcon    String          @default("trophy")
  users        UserChallenge[]
}

model UserChallenge {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress     Float      @default(0.0)
  isCompleted  Boolean    @default(false)
  joinedAt     DateTime   @default(now())
  completedAt  DateTime?

  @@unique([userId, challengeId])
}

model Goal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // WEEKLY_DISTANCE, MONTHLY_DISTANCE, WEEKLY_ACTIVITIES
  targetValue  Float
  currentValue Float     @default(0.0)
  period       String    // WEEKLY, MONTHLY
  startDate    DateTime
  endDate      DateTime
  isAchieved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  message      String
  type         String    // ACHIEVEMENT, CHALLENGE, STREAK, SAFETY, SYSTEM
  read         Boolean   @default(false)
  metadataJson String?   @default("{}")
  createdAt    DateTime  @default(now())
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  platform     String    // ANDROID, IOS, WEB
  appVersion   String
  lastActive   DateTime  @default(now())
}

model PrivacySettings {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVisibility     String    @default("PUBLIC") // PUBLIC, FOLLOWERS, PRIVATE
  activityVisibility    String    @default("PUBLIC")
  hideStartEndRadiusM   Int       @default(200) // Default 200m masking around start/finish
  showMapRoute          Boolean   @default(true)
  allowLiveTracking     Boolean   @default(true)
  updatedAt             DateTime  @updatedAt
}

model PrivacyZone {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String    // e.g., "Home", "Office", "University"
  latitude     Float
  longitude    Float
  radiusMeters Int       @default(500)
  createdAt    DateTime  @default(now())
}

model SafetyContact {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  email              String?
  relationship       String?
  notifyOnEmergency  Boolean   @default(true)
  createdAt          DateTime  @default(now())
}
