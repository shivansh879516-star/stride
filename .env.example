# STRIDE Environment Variables Example
# Copy this file to .env in backend/ or root as needed.

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=stride_super_secret_jwt_key_change_in_production_2025

# Database Configuration
# Default is local SQLite for instant zero-dependency execution.
# For PostgreSQL in production: postgresql://user:password@localhost:5432/stride_db?schema=public
DATABASE_URL="file:./dev.db"

# Optional Cloud Providers (Progressively Configurable)
# Map Tile Provider (Default uses free OpenStreetMap / CartoDB Dark & Light tiles)
MAP_PROVIDER=osm
MAP_API_KEY=

# Routing Provider (Default uses free OSRM / Geodesic algorithms)
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=

# Push Notifications (Optional - In-app notification engine functions out of the box)
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
